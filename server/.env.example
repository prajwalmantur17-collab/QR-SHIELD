PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# JWT Configuration
JWT_SECRET=super-secret-jwt-key-replace-in-production-min32chars
JWT_EXPIRES_IN=1h

# Privacy Hash Salt (Crucial: never reveal this)
HASH_SALT=qrshield-salt-secure-random-string-must-be-kept-secret

# Google Gemini API Key (Backend only, never expose to client)
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase PostgreSQL Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
